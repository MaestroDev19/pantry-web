############################################################
# Pantry (Next.js) example environment file
#
# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
############################################################

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Backend API Configuration (FastAPI microservice)
NEXT_PUBLIC_PANTRY_API_URL=http://127.0.0.1:8000

# Next.js site URL (used for redirects/callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

